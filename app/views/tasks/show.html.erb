<div class="task-detail-container">
  <div class="task-detail-card">
    <div class="task-detail-header">
      <h1><%= @task.title %></h1>
      <div class="task-badges">
        <span class="badge badge-<%= @task.status %>"><%= @task.status.humanize %></span>
        <span class="badge badge-priority-<%= @task.priority %>"><%= @task.priority.upcase %></span>
      </div>
    </div>

    <div class="task-detail-section">
      <h3>Description</h3>
      <p><%= @task.description.present? ? @task.description : "No description provided" %></p>
    </div>

    <div class="task-detail-meta">
      <div class="meta-item">
        <strong>Status:</strong>
        <span class="badge badge-<%= @task.status %>"><%= @task.status.humanize %></span>
      </div>
      <div class="meta-item">
        <strong>Priority:</strong>
        <span class="badge badge-priority-<%= @task.priority %>"><%= @task.priority.upcase %></span>
      </div>
      <div class="meta-item">
        <strong>Created:</strong>
        <span><%= @task.created_at.strftime("%B %d, %Y at %I:%M %p") %></span>
      </div>
      <div class="meta-item">
        <strong>Last Updated:</strong>
        <span><%= @task.updated_at.strftime("%B %d, %Y at %I:%M %p") %></span>
      </div>
    </div>

    <div class="task-detail-actions">
      <%= link_to "Edit Task", edit_task_path(@task), class: "btn btn-primary" %>
      <%= button_to "Delete Task", task_path(@task), method: :delete, 
                    data: { turbo_confirm: "Are you sure you want to delete this task?" }, 
                    class: "btn btn-danger" %>
      <%= link_to "Back to Tasks", tasks_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
