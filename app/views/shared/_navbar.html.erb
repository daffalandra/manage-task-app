<% if authenticated? %>
  <nav class="navbar">
    <div class="navbar-container">
      <div class="navbar-brand">
        <%= link_to "Task Manager", root_path, class: "navbar-logo" %>
      </div>
      
      <div class="navbar-menu">
        <div class="navbar-user">
          <svg class="navbar-user-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span class="navbar-email"><%= current_user.email_address %></span>
        </div>
        
        <%= button_to "Logout", session_path, method: :delete, class: "btn btn-logout" %>
      </div>
    </div>
  </nav>
<% end %>
